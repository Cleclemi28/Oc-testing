---
import { site, ctas } from '../data/site';
---

<section class="contact section" id="contact">
  <div class="container contact__grid">
    <div class="contact__intro">
      <p class="eyebrow" data-reveal="fade-up">Contact</p>
      <h2 data-reveal="fade-up" data-split="lines">Parlez-nous de votre projet</h2>
      <p class="lead" data-reveal="fade-up">
        Une question, un forum à organiser, une intervention à proposer ? Notre équipe vous répond
        rapidement.
      </p>

      <ul class="contact__details" data-reveal="fade-up">
        <li>
          <span class="contact__detail-label">Adresse</span>
          <span class="contact__detail-value">
            {site.address.street}<br />
            {site.address.postalCode} {site.address.city}
          </span>
        </li>
        <li>
          <span class="contact__detail-label">Email</span>
          <a class="contact__detail-value" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <span class="contact__detail-label">Téléphone</span>
          <a class="contact__detail-value" href={`tel:${site.phoneHref}`}>{site.phone}</a>
        </li>
      </ul>

      <div class="contact__actions" data-reveal="fade-up">
        <a class="btn btn--orange" href={ctas.join.href}>{ctas.join.label}</a>
        <a class="btn btn--ghost" href={ctas.donate.href} target="_blank" rel="noopener noreferrer">
          {ctas.donate.label}
        </a>
      </div>
    </div>

    <form class="contact__form" data-contact-form novalidate data-reveal="fade-up">
      <div class="field">
        <label for="contact-name">Nom complet</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="contact-email">Email</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required />
      </div>

      <div class="field">
        <label for="contact-message">Message</label>
        <textarea id="contact-message" name="message" rows="5" required></textarea>
      </div>

      <!-- Pot à miel : invisible pour les humains, piégeage des robots -->
      <div class="honeypot" aria-hidden="true">
        <label for="contact-company">Ne pas remplir</label>
        <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button class="btn contact__submit" type="submit">Envoyer</button>

      <p class="contact__legal">
        En envoyant ce formulaire, vous acceptez que les informations saisies soient traitées dans le
        cadre de votre demande de contact. Pour connaître et exercer vos droits, notamment de retrait de
        votre consentement, veuillez consulter notre
        <a href="https://lafetedelavie.fr/politique-de-confidentialite/">Politique de Confidentialité</a>
        dans les Mentions Légales.
      </p>

      <p class="contact__status" data-contact-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .contact {
    background: var(--c-white);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .contact__details {
    display: grid;
    gap: 1.1rem;
    margin-block: 2.25rem;
  }

  .contact__details li {
    display: grid;
    gap: 0.15rem;
  }

  .contact__detail-label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-text-3);
  }

  .contact__detail-value {
    font-size: var(--fs-lead);
    color: var(--c-ink);
  }

  a.contact__detail-value {
    transition: color 0.25s var(--ease-out);
  }

  a.contact__detail-value:hover {
    color: var(--c-accent);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .contact__form {
    display: grid;
    gap: 1.15rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--c-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-2);
  }

  .field input,
  .field textarea {
    inline-size: 100%;
    padding: 0.85rem 1rem;
    background: var(--c-white);
    border: 2px solid var(--c-line);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    transition:
      border-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--c-accent);
    box-shadow: 0 0 0 4px rgb(19 117 162 / 0.12);
  }

  .field textarea {
    resize: vertical;
    min-block-size: 130px;
    font-family: inherit;
  }

  .honeypot {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .contact__submit {
    justify-self: start;
  }

  .contact__legal {
    margin: 0;
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--c-text-3);
  }

  .contact__legal a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .contact__status {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--c-accent);
  }

  .contact__status:empty {
    display: none;
  }

  @media (max-width: 899px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-contact-status]');

  if (form && status) {
    // Aucun endpoint configuré : on bascule sur le client mail par défaut.
    const endpoint = form.dataset.endpoint ?? '';

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const honeypot = String(data.get('company') ?? '');

      if (honeypot) {
        status.textContent = 'Message envoyé.';
        form.reset();
        return;
      }

      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();

      if (!name || !email || !message) {
        status.textContent = 'Merci de remplir les champs obligatoires.';
        return;
      }

      if (endpoint) {
        fetch(endpoint, { method: 'POST', body: data })
          .then(() => {
            status.textContent = 'Merci ! Votre message a bien été envoyé.';
            form.reset();
          })
          .catch(() => {
            status.textContent = "L'envoi a échoué, merci de nous écrire directement par email.";
          });
        return;
      }

      const subject = encodeURIComponent(`Demande de contact — ${name}`);
      const body = encodeURIComponent(`${message}\n\n—\n${name}\n${email}`);
      window.location.href = `mailto:lafetedelavie@gmail.com?subject=${subject}&body=${body}`;
      status.textContent = 'Votre logiciel de messagerie va s’ouvrir.';
    });
  }
</script>
