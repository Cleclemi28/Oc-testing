---
import { site, nav, socials, legalLinks, ctas } from '../data/site';
import { logoImage } from '../data/images';

const icons: Record<string, string> = {
  instagram:
    '<path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c0 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2 0-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c0-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 3.15A6.65 6.65 0 1 0 12 18.65 6.65 6.65 0 0 0 12 5.35Zm0 10.98A4.33 4.33 0 1 1 12 7.67a4.33 4.33 0 0 1 0 8.66Zm8.48-11.24a1.55 1.55 0 1 1-3.1 0 1.55 1.55 0 0 1 3.1 0Z"/>',
  linkedin:
    '<path d="M6.94 8.9v11.7H3.2V8.9h3.74Zm.24-3.5a2.06 2.06 0 1 1-4.12 0 2.06 2.06 0 0 1 4.12 0ZM21.3 14.2v6.4h-3.73v-5.98c0-1.5-.54-2.52-1.87-2.52-1.02 0-1.63.69-1.9 1.35-.1.24-.12.57-.12.9v6.25H9.85s.05-10.14 0-11.2h3.73v1.59c.5-.76 1.38-1.85 3.36-1.85 2.45 0 4.36 1.6 4.36 5.05Z"/>',
  youtube:
    '<path d="M21.58 7.19a2.5 2.5 0 0 0-1.76-1.77C18.25 5 12 5 12 5s-6.25 0-7.82.42a2.5 2.5 0 0 0-1.76 1.77A26.1 26.1 0 0 0 2 12a26.1 26.1 0 0 0 .42 4.81 2.5 2.5 0 0 0 1.76 1.77C5.75 19 12 19 12 19s6.25 0 7.82-.42a2.5 2.5 0 0 0 1.76-1.77A26.1 26.1 0 0 0 22 12a26.1 26.1 0 0 0-.42-4.81ZM10 15.02V8.98L15.2 12 10 15.02Z"/>',
};
---

<footer class="footer" id="footer">
  <div class="footer__inner container container--wide">
    <div class="footer__brand">
      <img
        src={logoImage.src}
        alt="La Fête de la Vie"
        width={logoImage.width}
        height={logoImage.height}
        loading="lazy"
        decoding="async"
      />
      <p class="footer__tagline">
        Promouvoir la santé et le bien-être à travers des actions concrètes et une communauté soudée.
      </p>
      <div class="footer__socials">
        {
          socials.map((social) => (
            <a
              href={social.href}
              class="footer__social"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" class="icon" set:html={icons[social.icon]} />
            </a>
          ))
        }
      </div>
    </div>

    <nav class="footer__col" aria-label="Navigation de pied de page">
      <h2 class="footer__col-title">Navigation</h2>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__col-title">Nous soutenir</h2>
      <ul>
        <li><a href={ctas.organize.href}>{ctas.organize.label}</a></li>
        <li><a href={ctas.intervene.href}>{ctas.intervene.label}</a></li>
        <li>
          <a href={ctas.donate.href} target="_blank" rel="noopener noreferrer">{ctas.donate.label}</a>
        </li>
        <li><a href={ctas.youtube.href} target="_blank" rel="noopener noreferrer">{ctas.youtube.label}</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__col-title">Contact</h2>
      <address>
        <p>{site.address.street}<br />{site.address.postalCode} {site.address.city}</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
      </address>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container container--wide footer__bottom-inner">
      <p>© {new Date().getFullYear()} {site.legalName}. Tous droits réservés.</p>
      <ul class="footer__legal">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-teal);
    color: rgb(255 255 255 / 0.86);
    padding-block-start: clamp(3rem, 6vw, 5rem);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block-end: clamp(2.5rem, 5vw, 4rem);
  }

  .footer__brand img {
    inline-size: auto;
    block-size: 40px;
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }

  .footer__tagline {
    margin: 1.25rem 0 1.75rem;
    max-width: 320px;
    font-size: var(--fs-sm);
    line-height: 1.7;
  }

  .footer__socials {
    display: flex;
    gap: 0.6rem;
  }

  .footer__social {
    display: grid;
    place-items: center;
    inline-size: 42px;
    block-size: 42px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: var(--c-white);
    transition:
      background-color 0.28s var(--ease-out),
      translate 0.28s var(--ease-out);
  }

  .footer__social:hover {
    background: var(--c-orange);
    translate: 0 -3px;
  }

  .footer__col-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--c-white);
    margin-block-end: 1.1rem;
  }

  .footer__col ul {
    display: grid;
    gap: 0.6rem;
  }

  .footer__col a {
    font-size: var(--fs-sm);
    transition:
      color 0.25s var(--ease-out),
      padding-inline-start 0.25s var(--ease-out);
  }

  .footer__col a:hover {
    color: var(--c-orange);
    padding-inline-start: 0.35rem;
  }

  .footer__col address {
    font-style: normal;
    font-size: var(--fs-sm);
    line-height: 1.8;
  }

  .footer__col address p {
    margin-block-end: 0.5rem;
  }

  .footer__bottom {
    border-block-start: 1px solid rgb(255 255 255 / 0.14);
    padding-block: 1.5rem;
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--fs-xs);
  }

  .footer__bottom-inner p {
    margin: 0;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer__legal a:hover {
    color: var(--c-orange);
  }

  @media (max-width: 899px) {
    .footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 599px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
