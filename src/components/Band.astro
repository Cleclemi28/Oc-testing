---
const words = [
  { label: 'Prévenir', style: 'solid' },
  { label: 'Jouer', style: 'stroke' },
  { label: 'Partager', style: 'solid' },
  { label: 'Transmettre', style: 'stroke' },
] as const;

/* Le jeu est répété pour que la bande couvre largement l'écran. */
const set = [...words, ...words];
---

<section class="band" aria-hidden="true">
  <div class="band__track" data-band>
    {
      [1, 2].map((copy) => (
        <div class="band__set" aria-hidden={copy === 2 ? 'true' : undefined}>
          {set.map((word) => (
            <>
              <span class={`band__word band__word--${word.style}`}>{word.label}</span>
              <span class="band__sep">✦</span>
            </>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.25rem, 2.6vw, 2.25rem);
    background: var(--c-white);
    border-block: 1px solid var(--c-line);
  }

  .band__track {
    display: flex;
    align-items: center;
    inline-size: max-content;
    will-change: transform;
  }

  .band__set {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    padding-inline-end: clamp(0.75rem, 2vw, 1.75rem);
  }

  .band__word {
    font-family: var(--font-display);
    font-size: clamp(2rem, 7vw, 5.5rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--ls-display);
    white-space: nowrap;
  }

  .band__word--solid {
    color: var(--c-ink);
  }

  .band__word--stroke {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--c-cyan);
  }

  .band__sep {
    font-size: clamp(0.9rem, 2vw, 1.5rem);
    color: var(--c-orange);
    line-height: 1;
  }
</style>
