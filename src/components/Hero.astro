---
import { Picture } from 'astro:assets';
import { heroImage, badgeCyan, badgeOrange, badgeGreen } from '../data/images';
import { ctas } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<section class="hero" id="hero" data-hero>
  <div class="hero__media" data-hero-media aria-hidden="true">
    <Picture
      src={heroImage}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[640, 960, 1280]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__aurora" aria-hidden="true">
    <span class="hero__blob hero__blob--1"></span>
    <span class="hero__blob hero__blob--2"></span>
    <span class="hero__blob hero__blob--3"></span>
  </div>

  <div class="hero__spotlight" aria-hidden="true" data-hero-spotlight></div>

  <div class="hero__badges" aria-hidden="true" data-hero-badges>
    <img class="hero__badge hero__badge--1" src={badgeCyan.src} alt="" width="120" height="120" />
    <img class="hero__badge hero__badge--2" src={badgeOrange.src} alt="" width="120" height="120" />
    <img class="hero__badge hero__badge--3" src={badgeGreen.src} alt="" width="120" height="120" />
  </div>

  <div class="hero__inner container">
    <p class="hero__eyebrow" data-hero-fade>
      <span class="hero__dot" aria-hidden="true"></span>
      Association loi 1901 · Hauts-de-France
    </p>

    <h1 class="hero__title" data-split="lines">
      Faire de la<br />
      prévention santé<br />
      bien-être autrement
    </h1>

    <p class="hero__sub" data-hero-fade>
      Des forums santé-addictions festifs, ludiques et participatifs <strong>clés en main</strong> pour
      tous les publics.
    </p>

    <div class="hero__actions" data-hero-fade>
      <a class="btn" href={ctas.organize.href}>{ctas.organize.label}</a>
      <a class="btn btn--ghost" href={ctas.intervene.href}>{ctas.intervene.label}</a>
    </div>
  </div>

  <a class="hero__scroll" href="#manifeste" data-hero-scroll aria-label="Faire défiler vers la suite">
    <span class="hero__scroll-label">Découvrir</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>

  <noscript>
    <style>
      .hero__media img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
    </style>
  </noscript>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: 100svh;
    padding-block: calc(var(--header-h) + 2rem) 6rem;
    overflow: clip;
    isolation: isolate;
    background: var(--c-teal);
  }

  .hero__media {
    position: absolute;
    inset: -8% 0;
    z-index: -3;
  }

  .hero__media :global(picture),
  .hero__media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* Léger travelling avant/arrière sur la photo du hero. */
  .hero__media :global(img) {
    animation: hero-kenburns 22s var(--ease-in-out) infinite alternate;
  }

  @keyframes hero-kenburns {
    from {
      scale: 1.04;
    }
    to {
      scale: 1.14;
    }
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(120% 90% at 18% 20%, rgb(0 99 128 / 0.72), transparent 62%),
      linear-gradient(
        100deg,
        rgb(0 99 128 / 0.92) 0%,
        rgb(19 117 162 / 0.78) 42%,
        rgb(41 176 230 / 0.32) 100%
      );
  }

  /* Aurore : trois halos colorés qui respirent en arrière-plan. */
  .hero__aurora {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: clip;
  }

  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    mix-blend-mode: screen;
    will-change: transform;
  }

  .hero__blob--1 {
    inline-size: 46vw;
    block-size: 46vw;
    inset-block-start: -12%;
    inset-inline-start: -8%;
    background: radial-gradient(circle, rgb(41 176 230 / 0.85), transparent 68%);
    animation: blob-drift 16s var(--ease-in-out) infinite alternate;
  }

  .hero__blob--2 {
    inline-size: 38vw;
    block-size: 38vw;
    inset-block-end: -16%;
    inset-inline-end: -6%;
    background: radial-gradient(circle, rgb(255 138 0 / 0.55), transparent 68%);
    animation: blob-drift 21s var(--ease-in-out) infinite alternate-reverse;
  }

  .hero__blob--3 {
    inline-size: 30vw;
    block-size: 30vw;
    inset-block-start: 38%;
    inset-inline-start: 46%;
    background: radial-gradient(circle, rgb(204 51 102 / 0.45), transparent 66%);
    animation: blob-drift 26s var(--ease-in-out) infinite alternate;
  }

  @keyframes blob-drift {
    from {
      translate: -4% -3%;
      scale: 1;
    }
    to {
      translate: 8% 6%;
      scale: 1.18;
    }
  }

  /* Halo qui suit le curseur. */
  .hero__spotlight {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      380px circle at var(--mx, 50%) var(--my, 40%),
      rgb(255 255 255 / 0.16),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .hero:hover .hero__spotlight {
    opacity: 1;
  }

  .hero__badges {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__badge {
    position: absolute;
    inline-size: clamp(56px, 8vw, 120px);
    block-size: auto;
    opacity: 0.32;
    filter: drop-shadow(0 18px 30px rgb(0 40 60 / 0.35));
    will-change: transform;
  }

  .hero__badge--1 {
    inset-block-start: 14%;
    inset-inline-start: 6%;
    rotate: -12deg;
  }

  .hero__badge--2 {
    inset-block-start: 22%;
    inset-inline-end: 8%;
    rotate: 14deg;
    opacity: 0.24;
  }

  .hero__badge--3 {
    inset-block-end: 12%;
    inset-inline-start: 16%;
    rotate: 8deg;
    opacity: 0.2;
  }

  .hero__inner {
    position: relative;
    max-width: 900px;
    text-align: center;
    color: var(--c-white);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin: 0 0 1.4rem;
    padding: 0.45rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.12);
    backdrop-filter: blur(8px);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero__dot {
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    background: var(--c-orange);
    box-shadow: 0 0 0 0 rgb(255 138 0 / 0.7);
    animation: pulse 2.4s infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 12px rgb(255 138 0 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(255 138 0 / 0);
    }
  }

  .hero__title {
    color: var(--c-white);
    text-transform: uppercase;
    text-shadow: 0 12px 40px rgb(0 40 60 / 0.35);
    margin-bottom: 1.5rem;
  }

  .hero__sub {
    max-width: 640px;
    margin: 0 auto 2.25rem;
    font-size: var(--fs-lead);
    color: rgb(255 255 255 / 0.92);
  }

  .hero__sub strong {
    color: var(--c-white);
    font-weight: 600;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .hero__actions .btn {
    --btn-bg: var(--c-orange);
    --btn-fg: #2b1a00;
    box-shadow: 0 14px 30px -14px rgb(0 40 60 / 0.8);
  }

  .hero__actions .btn::after {
    background: linear-gradient(120deg, #ffb347, var(--c-orange));
  }

  .hero__actions .btn--ghost {
    --btn-bg: rgb(255 255 255 / 0.12);
    --btn-fg: var(--c-white);
    border-color: rgb(255 255 255 / 0.55);
    backdrop-filter: blur(8px);
  }

  .hero__actions .btn--ghost::after {
    background: var(--c-white);
  }

  .hero__actions .btn--ghost:hover {
    color: var(--c-teal);
  }

  .hero__scroll {
    position: absolute;
    inset-block-end: 1.75rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    color: rgb(255 255 255 / 0.85);
    font-size: var(--fs-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero__scroll-line {
    inline-size: 1px;
    block-size: 52px;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.8), transparent);
    overflow: hidden;
    position: relative;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c-orange);
    translate: 0 -100%;
    animation: scroll-hint 2.1s var(--ease-in-out) infinite;
  }

  @keyframes scroll-hint {
    0% {
      translate: 0 -100%;
    }
    60%,
    100% {
      translate: 0 100%;
    }
  }

  @media (max-width: 767px) {
    .hero__badge--2,
    .hero__badge--3 {
      display: none;
    }

    .hero__title {
      text-transform: none;
    }
  }
</style>
