---
import { steps } from '../data/content';
import { ctas } from '../data/site';
---

<section class="steps section" id="etapes">
  <div class="container">
    <div class="section__head section__head--center">
      <p class="eyebrow" data-reveal="fade-up">De l'idée au jour J</p>
      <h2 data-reveal="fade-up" data-split="lines">Des forums sur mesure</h2>
      <p class="lead" data-reveal="fade-up">Nous nous occupons avec vous de :</p>
    </div>

    <ol class="steps__list" data-steps>
      <span class="steps__rail" aria-hidden="true">
        <span class="steps__rail-fill" data-steps-fill></span>
      </span>

      {
        steps.map((step, index) => (
          <li class="step" data-step data-reveal="fade-up">
            <span class="step__marker" aria-hidden="true">
              <span class="step__number">{step.number}</span>
            </span>
            <div class="step__card">
              <h3 class="step__title">{step.title}</h3>
              <p class="step__body">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="steps__cta" data-reveal="fade-up">
      <a class="btn" href={ctas.organize.href}>{ctas.organize.label}</a>
    </div>
  </div>
</section>

<style>
  .steps {
    background: var(--c-bg);
  }

  .steps__list {
    position: relative;
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    max-width: 900px;
    margin-inline: auto;
    padding-inline-start: clamp(3rem, 7vw, 5.5rem);
  }

  .steps__rail {
    position: absolute;
    inset-block: 1.5rem 1.5rem;
    inset-inline-start: clamp(1.1rem, 2.6vw, 1.9rem);
    inline-size: 3px;
    border-radius: 2px;
    background: var(--c-line);
    overflow: hidden;
  }

  .steps__rail-fill {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--c-cyan), var(--c-accent) 55%, var(--c-rose));
    transform-origin: top;
    scale: 1 0;
  }

  .step {
    position: relative;
    display: grid;
    gap: 0.6rem;
  }

  .step__marker {
    position: absolute;
    inset-inline-start: calc(clamp(3rem, 7vw, 5.5rem) * -1);
    inset-block-start: 0.15rem;
    inline-size: clamp(2.2rem, 5.2vw, 3.8rem);
    block-size: clamp(2.2rem, 5.2vw, 3.8rem);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--c-white);
    border: 2px solid var(--c-line);
    box-shadow: var(--shadow-sm);
    transition:
      background-color 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out),
      scale 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }

  .step__number {
    font-family: var(--font-display);
    font-size: clamp(0.8rem, 1.6vw, 1.05rem);
    color: var(--c-text-3);
    transition: color 0.5s var(--ease-out);
  }

  .step.is-active .step__marker {
    background: var(--c-accent);
    border-color: var(--c-accent);
    scale: 1.08;
    box-shadow: 0 0 0 8px rgb(19 117 162 / 0.12);
  }

  .step.is-active .step__number {
    color: var(--c-white);
  }

  .step__card {
    padding: clamp(1.25rem, 2.6vw, 1.9rem) clamp(1.25rem, 2.6vw, 2rem);
    background: var(--c-white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow 0.5s var(--ease-out),
      translate 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out);
  }

  .step.is-active .step__card {
    box-shadow: var(--shadow);
    translate: 6px 0;
  }

  .step__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.45rem;
    margin-bottom: 0.4rem;
  }

  .step__body {
    margin: 0;
    color: var(--c-text-2);
    font-size: var(--fs-sm);
    line-height: 1.7;
  }

  .steps__cta {
    display: flex;
    justify-content: center;
    margin-block-start: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (max-width: 599px) {
    .steps__list {
      padding-inline-start: 2.5rem;
    }

    .step__marker {
      inset-inline-start: -2.5rem;
    }
  }
</style>
